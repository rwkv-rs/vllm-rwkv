[Unit]
Description=RWKV multi-model OpenAI API router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rwkv
Group=rwkv
WorkingDirectory=/opt/rwkv/vllm/current
LoadCredential=api-key-sha256:/etc/rwkv/vllm.rwkvos.com.key.sha256
ExecStart=/usr/local/libexec/rwkv-api-router \
  --api-key-sha256-file ${CREDENTIALS_DIRECTORY}/api-key-sha256 \
  --upstream rwkv7-g1k-1.5b=http://127.0.0.1:28001 \
  --upstream rwkv7-g1k-2.9b=http://127.0.0.1:28002 \
  --upstream rwkv7-g1k-7.2b=http://127.0.0.1:28003 \
  --upstream rwkv7-g1k-13.3b=http://127.0.0.1:28004
LimitNOFILE=65536
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
